# SignalForge environment configuration

API_URL=http://localhost:8000

NEXT_PUBLIC_ENABLE_BACKTESTS=true
NEXT_PUBLIC_ENABLE_ALERTS=false

ENABLE_BACKTESTS=true
ENABLE_ALERTS=false

# MUST remain false for judged/live deployment.
ALLOW_MOCK_FALLBACK=false

PROJECT_SLUG=signalforge
# Exact 40-character reviewed commit. VERCEL_GIT_COMMIT_SHA and CF_PAGES_COMMIT_SHA are also detected automatically.
GIT_COMMIT=

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
